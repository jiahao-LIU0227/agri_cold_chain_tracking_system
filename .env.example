# ============================================================
# 环境变量模板
#
# 用法：复制这个文件为 .env，然后填上你自己的值
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Git Bash / macOS / Linux)
#
# .env 已经在 .gitignore 里，不会被提交。
# 这个模板文件本身要提交，方便组员知道有哪些变量。
# ============================================================

# ---- MySQL ----
# DB_PASSWORD 填你自己的 MySQL 密码，不要提交到仓库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cold_chain
DB_CHARSET=utf8mb4

# ---- 高德地图 ----
# 去 https://lbs.amap.com/ 控制台申请，两个 Key 用途不同，不要混用

# JS API Key：给前端网页加载地图用。会出现在页面源码里，藏不住，
# 所以一定要在控制台配置「域名白名单」（本地开发填 localhost）
AMAP_JS_KEY=

# JS API 2.0 安全密钥：和上面的 JS Key 配对使用，缺了地图加载不出来
AMAP_JS_SECURITY_CODE=

# Web 服务 Key：只给后端调路径规划和 POI 搜索用。
# 它带着你的调用配额，绝对不能返回给前端页面
AMAP_WEB_KEY=

# ---- 算法阈值 ----
# 这些值先按经验设定，后面通过测试调整。改这里不用动代码。
V_STOP=0.5              # 速度低于该值(m/s)算「准停留」
T_MIN=180               # 准停留超过该秒数才算正式停留
T_ABNORMAL=1800         # 不在任何 POI 且超过该秒数算异常停留
T_TEMP=300              # 温度超限持续该秒数才生成事件
ROUTE_BUFFER=200        # 偏离规划路线超过该米数算偏航
GEOFENCE_RADIUS=200     # 起点/终点围栏半径(米)

# ---- 采样与模拟 ----
SAMPLE_INTERVAL=10      # 模拟器采样周期(秒)
RANDOM_SEED=42          # 固定随机种子，保证每次模拟结果一致

# ---- Flask ----
FLASK_DEBUG=1
FLASK_PORT=5000
